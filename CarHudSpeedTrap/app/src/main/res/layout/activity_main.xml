<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="車機神盾 HUD 控制台"
            android:textColor="#00D2FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="開機自啟 + 高頻 GPS 原生時速 + 神盾測速通知監聽"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- 第一步：系統權限檢查 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="【第一步：系統核心權限檢查】"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_grant_notification"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1E293B"
            android:text="1. 啟用「通知存取權」(讀取神盾通知)"
            android:textColor="#38BDF8" />

        <Button
            android:id="@+id/btn_grant_location"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1E293B"
            android:text="2. 啟用「GPS 定位權限」(獲取精確車速)"
            android:textColor="#38BDF8" />

        <Button
            android:id="@+id/btn_grant_overlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1E293B"
            android:text="3. 啟用「懸浮窗權限」(全域置頂橫條)"
            android:textColor="#38BDF8" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- 即時神盾與 GPS 診斷面板 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="【即時監聽與 GPS 診斷核心面板】"
            android:textColor="#00F2FE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#151E32"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 監聽服務連線狀態 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_listener_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● 通知監聽狀態: 檢查中..."
                    android:textColor="#F59E0B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_rebind_listener"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#0284C7"
                    android:text="強制重新連線"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 神盾測速安裝狀態 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_speedtrap_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● 神盾 App 狀態: 偵測中..."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_launch_speedtrap"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#10B981"
                    android:text="立即啟動神盾"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_diag_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="最後收到通知時間: 尚未收到"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_diag_pkg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="通知 App 來源: 無"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_diag_raw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="原始通知文字: 無"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_diag_parsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="解析結果: 速限 -- | 距離 0m | 車速 0"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#22FFFFFF" />

            <!-- 即時 GPS 車速與衛星座標 -->
            <TextView
                android:id="@+id/tv_diag_gps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="車載 GPS 狀態: 搜尋衛星中..."
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_diag_gps_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="定位座標: 等待訊號中"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- 神盾應用設定卡片 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="【神盾測速 App 連動與喚醒設定】"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_current_speedtrap_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="神盾應用偵測：正在檢查..."
            android:textColor="#10B981"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_choose_speedtrap_app"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="#0369A1"
                android:text="手動選擇神盾 App"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_test_launch_speedtrap"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#0F766E"
                android:text="測試立即喚醒神盾"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- 模式開關卡片 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="【第二步：HUD 懸浮條開關與模擬測試】"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_overlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#0284C7"
            android:text="開啟全域置頂懸浮橫條 (HUD)"
            android:textColor="#FFFFFF" />

        <!-- HUD 透明度調節 (防止遮蔽底層前台導航/地圖) -->
        <TextView
            android:id="@+id/tv_hud_alpha_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="HUD 懸浮條透明度（防遮擋前台 App）：目前為高透 (72%)"
            android:textColor="#38BDF8"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_alpha_extreme"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="極度通透 (50%)"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_alpha_high"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#0284C7"
                android:text="高透 (72%)"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_alpha_standard"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="標準 (88%)"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test_normal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="#0F766E"
                android:text="模擬正常測速"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_test_overspeed"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#BE123C"
                android:text="模擬超速警報"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_test_gps_speed"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#7C3AED"
                android:text="模擬時速跳動"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- Android Auto 綁定設定 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="【第三步：指定投屏 / Android Auto 快捷鍵】"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_current_aa_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="目前綁定：自動智慧偵測 (ZLINK / AutoKit)"
            android:textColor="#10B981"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_choose_aa_app"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1E293B"
            android:text="選擇車機上的 Android Auto / 投屏 App"
            android:textColor="#38BDF8" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- 退出與關閉程式 -->
        <Button
            android:id="@+id/btn_exit_app"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#BE123C"
            android:text="❌ 徹底關閉並退出本程式 (Exit App)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
