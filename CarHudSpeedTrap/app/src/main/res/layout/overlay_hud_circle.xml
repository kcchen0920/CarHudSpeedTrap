<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical|end"
    android:orientation="horizontal"
    android:padding="4dp">

    <!-- 點擊展開之快捷選單與警示詳情 (平常隱藏，點擊圓形時展開，5秒無操作自動折疊) -->
    <LinearLayout
        android:id="@+id/layout_expanded_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_hud_pill_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- 相機類型與詳細訊息 -->
        <TextView
            android:id="@+id/tv_expanded_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="🟢 服務就緒"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 快捷操作列 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_circle_aa"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_btn_aa"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="🚗 AA"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_circle_wifi"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_wifi"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="📶 Wi-Fi"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_circle_close"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_close"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="✕ 關閉"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右上角常駐小型圓形 HUD 本體 (直徑 66dp，高通透半透明，精巧不擋畫面) -->
    <FrameLayout
        android:id="@+id/circle_badge"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/bg_hud_circle"
        android:clickable="true"
        android:focusable="true">

        <!-- 頂部：速限標誌圓圈 (僅在有測速照相速限時顯示) -->
        <TextView
            android:id="@+id/tv_circle_speed_limit"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_mini_speed_limit"
            android:gravity="center"
            android:text="--"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 中央：即時 GPS 車速數值 -->
        <TextView
            android:id="@+id/tv_circle_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 底部：單位 (km/h) 或 測速距離倒數 (如 350m) -->
        <TextView
            android:id="@+id/tv_circle_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:text="km/h"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

    </FrameLayout>

</LinearLayout>
