<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_hud_top_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- 1. 左側：速限標誌 -->
    <TextView
        android:id="@+id/tv_speed_limit"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_speed_limit_circle"
        android:gravity="center"
        android:text="--"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 2. 中央：測速相機倒數進度條 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_cam_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 服務就緒"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_distance"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="2dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_cyan" />
    </LinearLayout>

    <!-- 3. 右側：目前即時車速 -->
    <TextView
        android:id="@+id/tv_current_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/text_white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:text="km/h"
        android:textColor="@color/text_gray"
        android:textSize="10sp" />

    <!-- 4. 快速連線切換群組 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Android Auto 按鈕 -->
        <TextView
            android:id="@+id/btn_launch_aa"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_aa"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🚗 AA"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Wi-Fi 聯網按鈕 -->
        <TextView
            android:id="@+id/btn_toggle_wifi"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_wifi"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="📶 Wi-Fi"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
