<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="車機神盾 HUD 控制台"
            android:textColor="#00D2FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="整合神盾測速通知 + CarWebGuru 小工具 + AA/Wi-Fi 快速切換"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- 權限狀態卡片 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="【第一步：系統權限檢查】"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_grant_notification"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1E293B"
            android:text="啟用「通知存取權」(讀取神盾通知)"
            android:textColor="#38BDF8" />

        <Button
            android:id="@+id/btn_grant_overlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1E293B"
            android:text="啟用「懸浮窗權限」(若使用全域置頂橫條)"
            android:textColor="#38BDF8" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- Android Auto 綁定設定 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="【第二步：指定 Android Auto 投屏應用】"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_current_aa_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="目前綁定：自動智慧偵測"
            android:textColor="#10B981"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_choose_aa_app"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0369A1"
            android:text="選擇車機上的 Android Auto / 投屏 App"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- 模式開關卡片 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="【第三步：功能啟用與模擬測試】"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_overlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1E293B"
            android:text="開啟全域置頂懸浮橫條 (選用)"
            android:textColor="#38BDF8" />

        <Button
            android:id="@+id/btn_toggle_bt_auto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1E293B"
            android:text="🚗 藍牙自動化：已啟用 (上車自動啟動)"
            android:textColor="#10B981" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test_clear"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="#059669"
                android:text="路況順暢"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_test_normal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#0284C7"
                android:text="相機巡航"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_test_warn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#D97706"
                android:text="近距/微超"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_test_overspeed"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#DC2626"
                android:text="嚴重超速"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
